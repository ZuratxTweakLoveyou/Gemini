-- [[ Axiom Engine - Dynamic Hitbox Expander Injection ]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Configuration Payload
local HitboxConfig = {
    Enabled = true,
    Size = 20, -- Default expander size (Adjustable infinitely)
    Transparency = 0.7,
    Color = Color3.fromRGB(255, 0, 120),
    CanCollide = false
}

-- Primary Dynamic Hitbox Processor
local function ProcessHitbox(player)
    if player == LocalPlayer then return end
    
    local function ExpandParts()
        if not player.Character then return end
        
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if root then
            if HitboxConfig.Enabled then
                root.Size = Vector3.new(HitboxConfig.Size, HitboxConfig.Size, HitboxConfig.Size)
                root.Transparency = HitboxConfig.Transparency
                root.Color = HitboxConfig.Color
                root.Material = Enum.Material.Neon
                root.CanCollide = HitboxConfig.CanCollide
            else
                -- Revert to original engine defaults
                root.Size = Vector3.new(2, 2, 1)
                root.Transparency = 1
                root.CanCollide = false
            end
        end
    end

    player.CharacterAdded:Connect(function()
        task.wait(0.2)
        ExpandParts()
    end)
    
    if player.Character then
        ExpandParts()
    end
end

-- Initialize Engine Hooks Across All Entities
for _, player in pairs(Players:GetPlayers()) do
    ProcessHitbox(player)
end
Players.PlayerAdded:Connect(ProcessHitbox)

-- High-Frequency State Override Enforcement Loop
RunService.Stepped:Connect(function()
    if not HitboxConfig.Enabled then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then
                root.Size = Vector3.new(HitboxConfig.Size, HitboxConfig.Size, HitboxConfig.Size)
                root.Transparency = HitboxConfig.Transparency
                root.Color = HitboxConfig.Color
                root.Material = Enum.Material.Neon
                root.CanCollide = HitboxConfig.CanCollide
            end
        end
    end
end)

-- Runtime API Adjuster for Infinite Sizing
_G.SetHitboxSize = function(newSize)
    HitboxConfig.Size = tonumber(newSize) or HitboxConfig.Size
end

_G.ToggleHitbox = function(state)
    HitboxConfig.Enabled = state
end
